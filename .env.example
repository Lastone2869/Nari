# Copy to .env (git-ignored). Both are optional: without them the Safety Map shows a placeholder.
VITE_GOOGLE_MAPS_API_KEY=
# A Map ID from Google Cloud console (required for Advanced Markers). DEMO_MAP_ID works for testing.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# reCAPTCHA v3 site key for Firebase App Check (abuse protection). Leave empty to disable.
VITE_RECAPTCHA_SITE_KEY=
# Set to 1 to use the local Firebase emulators instead of the live project.
VITE_USE_EMULATORS=
